# Copy to .env and fill in.
PAPERCUTS_DB=data/papercuts.db
PAPERCUTS_OPENALEX_API_KEY=
PAPERCUTS_MAILTO=you@example.com
PAPERCUTS_MAX_CONCURRENCY=4
PAPERCUTS_TIMEOUT=30

# Phase 2
# Embedding model: bge-small (fast, default) | bge-base (better, slower) | specter (scientific papers)
PAPERCUTS_EMBED_MODEL=bge-small
# Optional Semantic Scholar key (free, request at semanticscholar.org/product/api)
PAPERCUTS_S2_API_KEY=
